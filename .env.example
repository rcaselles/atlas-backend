# Copia este archivo a .env para desarrollo local. Nunca subas .env (el repo es público).
ATLAS_ENV=development
# Orígenes del frontend permitidos por CORS, separados por comas
ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Agregador de noticias
ATLAS_NEWS_SOURCES_FILE=config/sources.yaml
ATLAS_NEWS_POLLING=true
ATLAS_NEWS_MAX_ITEMS=1000
