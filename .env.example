# Copia este archivo a .env para desarrollo local. Nunca subas .env (el repo es público).
ATLAS_ENV=development
# Orígenes del frontend permitidos por CORS, separados por comas
ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Agregador de noticias
ATLAS_NEWS_SOURCES_FILE=config/sources.yaml
ATLAS_NEWS_POLLING=true
ATLAS_NEWS_MAX_ITEMS=1000
# Cotizaciones: cripto por el websocket público de Binance, acciones con retraso desde Yahoo Finance (sin clave)
ATLAS_MARKET_STREAMING=true
# Lista de seguimiento inicial como SIMBOLO:tipo (crypto o stock)
ATLAS_DEFAULT_WATCHLIST=BTCUSDT:crypto,ETHUSDT:crypto,SOLUSDT:crypto,AAPL:stock,MSFT:stock,NVDA:stock,TSLA:stock,SAN.MC:stock
# Dónde se guarda la lista tras editarla (en hosting gratuito el disco puede borrarse al reiniciar)
ATLAS_WATCHLIST_FILE=data/watchlist.json
# Segundos entre consultas de acciones (mínimo 30)
ATLAS_STOCK_POLL_SECONDS=60
ATLAS_BINANCE_WS_URLS=wss://data-stream.binance.vision,wss://stream.binance.com:9443
